# Server
# Navnet som vises øverst på sidene og i fanen
APP_NAME=Møterom
PORT=3000
BASE_URL=http://localhost:3000
TIMEZONE=Europe/Oslo

# Session
# PÅKREVD: tjenesten nekter å starte uten en egen SESSION_SECRET (minst 16 tegn).
# Generer en tilfeldig verdi, f.eks.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Sett til "true" når tjenesten kjører bak en TLS-terminerende reverse proxy (f.eks. Caddy/nginx),
# slik at sesjonscookien kun sendes over HTTPS.
COOKIE_SECURE=false

# SMTP (for å sende møtebekreftelser med kalenderinvitasjon)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bookinger@example.com
SMTP_PASS=hemmelig
MAIL_FROM_NAME=Møteromsbooking
MAIL_FROM_EMAIL=bookinger@example.com

# Valgfritt: kopi av alle nye bookinger til en intern adresse
ADMIN_NOTIFY_EMAIL=
