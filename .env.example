# Server
# Navnet som vises øverst på sidene og i fanen
APP_NAME=Møterom
PORT=3000
# Lytter bare lokalt som standard (bak nginx/Caddy). Sett 0.0.0.0 for å nå den direkte fra nettverket.
HOST=127.0.0.1
BASE_URL=http://localhost:3000
TIMEZONE=Europe/Oslo

# Session
# PÅKREVD: tjenesten nekter å starte uten en egen SESSION_SECRET (minst 16 tegn).
# Generer en tilfeldig verdi, f.eks.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Sett til "true" når tjenesten kjører bak en TLS-terminerende reverse proxy (f.eks. Caddy/nginx),
# slik at sesjonscookien kun sendes over HTTPS.
COOKIE_SECURE=false

# SMTP (for å sende møtebekreftelser med kalenderinvitasjon)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bookinger@example.com
SMTP_PASS=hemmelig
MAIL_FROM_NAME=Møteromsbooking
MAIL_FROM_EMAIL=bookinger@example.com

# Valgfritt: kopi av alle nye bookinger og varsel om nye tilgangsforespørsler til en intern adresse
ADMIN_NOTIFY_EMAIL=

# Booking
# Når SMTP er satt opp, må den som booker bekrefte via lenke i e-posten før bookingen gjelder.
# Sett til "false" for å skru det av. Uten SMTP er bookinger alltid gyldige med en gang.
BOOKING_CONFIRMATION=true
# Hvor lenge en ubekreftet booking holder av tiden (minutter)
PENDING_HOLD_MINUTES=30

# Personvern
# Navn, e-post og møtetittel anonymiseres så mange måneder etter at møtet er over
RETENTION_MONTHS=6
# Revisjonsloggen slettes etter så mange måneder
AUDIT_RETENTION_MONTHS=12
# Kontaktadresse i personvernerklæringen (standard: ADMIN_NOTIFY_EMAIL, deretter MAIL_FROM_EMAIL)
PRIVACY_CONTACT=
