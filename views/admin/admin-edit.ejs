<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Administrer ' + target.username }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <a class="back-link" href="/admin/tilgang"><%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %>Tilgang</a>

    <div class="page-head">
      <div>
        <h1 class="title"><%= target.name || target.username %></h1>
        <p class="lede"><%= roleLabel(target.role) %> siden <%= new Date(target.created_at.replace(' ', 'T') + 'Z').toLocaleDateString('nb-NO', { dateStyle: 'long' }) %>.
          <% if (target.must_change_password) { %>Må velge nytt passord ved neste innlogging.<% } %></p>
      </div>
    </div>

    <form class="form-card form-card-wide" method="post" action="/admin/administratorer/<%= target.id %>">
      <h2 class="form-section-title">Kontoopplysninger</h2>
      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= error %></span></div>
      <% } %>
      <div class="field-row">
        <div class="field">
          <label for="name">Navn</label>
          <input class="input" type="text" id="name" name="name" maxlength="80" value="<%= values.name || '' %>" />
        </div>
        <div class="field">
          <label for="email">E-post</label>
          <input class="input" type="email" id="email" name="email" maxlength="120" value="<%= values.email || '' %>" />
        </div>
      </div>
      <div class="field">
        <label for="username">Brukernavn <span class="label-hint">(brukes for å logge inn)</span></label>
        <input class="input" type="text" id="username" name="username" maxlength="40" pattern="[\w.@\-]{3,40}" value="<%= values.username %>" required />
      </div>
      <fieldset class="field fieldset role-choice">
        <legend>Rolle</legend>
        <% Object.entries(roles).forEach(function ([key, role]) { %>
          <label class="check">
            <input type="radio" name="role" value="<%= key %>" <%= (values.role || target.role) === key ? 'checked' : '' %> />
            <span><strong><%= role.label %></strong><span class="check-hint"><%= role.description %></span></span>
          </label>
        <% }) %>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Lagre endringer</button>
        <a class="btn btn-ghost" href="/admin/tilgang">Avbryt</a>
      </div>
    </form>

    <section class="form-card form-card-wide account-section" aria-labelledby="reset-title">
      <h2 class="form-section-title" id="reset-title">Tilbakestill passord</h2>
      <p class="form-section-note form-section-note-flush">
        Lager et midlertidig passord som vises for deg én gang. <%= target.name || target.username %> blir logget ut overalt, og må velge nytt passord ved neste innlogging.
      </p>
      <form method="post" action="/admin/administratorer/<%= target.id %>/tilbakestill">
        <% if (target.email && canEmail) { %>
          <label class="check">
            <input type="checkbox" name="sendEmail" value="1" />
            <span>Send det midlertidige passordet til <strong><%= target.email %></strong></span>
          </label>
        <% } else if (!target.email) { %>
          <p class="form-section-note form-section-note-flush">Kontoen har ingen e-post, så du må gi passordet videre selv.</p>
        <% } else { %>
          <p class="form-section-note form-section-note-flush">E-post er ikke satt opp på serveren, så du må gi passordet videre selv.</p>
        <% } %>
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary" data-confirm data-confirm-label="Bekreft tilbakestilling">Tilbakestill passord</button>
        </div>
      </form>
    </section>

    <section class="form-card form-card-wide account-section" aria-labelledby="remove-title">
      <h2 class="form-section-title" id="remove-title">Fjern tilgang</h2>
      <% if (adminCount > 1 && !(target.role === 'admin' && adminRoleCount <= 1)) { %>
        <p class="form-section-note form-section-note-flush">Kontoen slettes, og <%= target.name || target.username %> logges ut med en gang. Rom og bookinger påvirkes ikke.</p>
        <form method="post" action="/admin/administratorer/<%= target.id %>/fjern">
          <div class="form-actions">
            <button type="submit" class="btn btn-danger" data-confirm data-confirm-label="Bekreft fjerning">
              <%- include('../partials/icon', { name: 'trash', size: 15 }) %>Fjern tilgang
            </button>
          </div>
        </form>
      <% } else { %>
        <p class="form-section-note form-section-note-flush">Dette er den eneste med rollen administrator, så tilgangen kan ikke fjernes.</p>
      <% } %>
    </section>
  </main>

  <script src="/js/ui.js" defer></script>
</body>
</html>
