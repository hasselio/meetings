<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Bookinger', calendar: Boolean(activeRoom) }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <div class="page-head">
      <div>
        <h1 class="title">Bookinger</h1>
        <p class="lede">Klikk på et møte for å se hvem som har booket, eller avlyse det.</p>
      </div>
    </div>

    <% if (!activeRoom) { %>
      <section class="board">
        <div class="empty-state">
          <span class="empty-icon"><%- include('../partials/icon', { name: 'door', size: 22 }) %></span>
          <h2>Ingen rom å vise bookinger for</h2>
          <p>Legg til rom under «Rom». Når et rom finnes, vises kalenderen med bookingene her.</p>
          <% if (can('rooms.manage')) { %><a class="btn btn-primary" href="/admin/rom/ny"><%- include('../partials/icon', { name: 'plus', size: 16 }) %>Nytt rom</a><% } %>
        </div>
      </section>
    <% } else { %>
      <div class="toolbar">
        <nav class="segmented" aria-label="Velg rom">
          <% rooms.forEach(function (room) { %>
            <a href="/admin?rom=<%= room.id %>" class="room-tab" aria-current="<%= room.id === activeRoom.id ? 'true' : 'false' %>">
              <span class="room-color" style="--c: <%= room.color %>"></span><%= room.name %>
            </a>
          <% }) %>
        </nav>
      </div>

      <div class="room-bar">
        <div class="room-bar-meta">
          <% if (activeRoom.location) { %>
            <span class="meta-item"><%- include('../partials/icon', { name: 'pin', size: 15 }) %><%= activeRoom.location %></span>
          <% } %>
          <% if (activeRoom.capacity) { %>
            <span class="meta-item"><%- include('../partials/icon', { name: 'users', size: 15 }) %><%= activeRoom.capacity %> plasser</span>
          <% } %>
          <a class="meta-item" href="/rom/<%= activeRoom.id %>" data-preview>
            <%- include('../partials/icon', { name: 'monitor', size: 14 }) %>Se som besøkende
          </a>
        </div>
        <% if (can('rooms.manage')) { %>
          <a class="room-bar-link" href="/admin/rom/<%= activeRoom.id %>/rediger">Romdetaljer <%- include('../partials/icon', { name: 'arrow-right', size: 14 }) %></a>
        <% } %>
      </div>

      <section class="calendar-card" aria-label="Kalender for <%= activeRoom.name %>">
        <div id="calendar" data-room-id="<%= activeRoom.id %>" data-room-color="<%= activeRoom.color %>"></div>
      </section>
    <% } %>
  </main>

  <div class="overlay" id="overlay"></div>
  <aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">
    <div class="drawer-head">
      <h2 class="drawer-title" id="drawerTitle"></h2>
      <button type="button" class="btn btn-ghost btn-icon" id="drawerClose" aria-label="Lukk"><%- include('../partials/icon', { name: 'x', size: 18 }) %></button>
    </div>
    <div class="drawer-body">
      <dl class="details">
        <div><dt>Tid</dt><dd class="tabular" id="dWhen"></dd></div>
        <div><dt>Rom</dt><dd id="dRoom"></dd></div>
        <div><dt>Booket av</dt><dd id="dName"></dd></div>
        <div><dt>E-post</dt><dd><a id="dEmail"></a></dd></div>
        <div id="dNotesWrap"><dt>Notat</dt><dd id="dNotes"></dd></div>
      </dl>
    </div>
    <% if (can('bookings.manage')) { %>
    <div class="drawer-foot">
      <button type="button" class="btn btn-danger" id="cancelBookingBtn" data-confirm-label="Bekreft avlysning">Avlys møte</button>
    </div>
    <% } %>
  </aside>

  <script src="/js/ui.js" defer></script>
  <% if (activeRoom) { %><script src="/js/admin-calendar.js" defer></script><% } %>
</body>
</html>
