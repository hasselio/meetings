<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Velg nytt passord' }) %>
</head>
<body>
  <main class="auth">
    <div class="auth-card">
      <%- include('../partials/brand', { tag: 'Admin' }) %>
      <h1 class="title">Velg nytt passord</h1>
      <p class="lede">Passordet ditt er tilbakestilt av en administrator. Velg et nytt før du fortsetter.</p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= error %></span></div>
      <% } %>

      <form method="post" action="/admin/nytt-passord">
        <input type="text" name="username" value="<%= me.username %>" autocomplete="username" hidden />
        <div class="field">
          <label for="password">Nytt passord <span class="label-hint">(minst 10 tegn)</span></label>
          <input class="input" type="password" id="password" name="password" minlength="10" autocomplete="new-password" required autofocus />
        </div>
        <div class="field">
          <label for="passwordConfirm">Gjenta nytt passord</label>
          <input class="input" type="password" id="passwordConfirm" name="passwordConfirm" minlength="10" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Lagre og fortsett</button>
      </form>

      <form method="post" action="/admin/logout" class="auth-footer">
        <button type="submit" class="link-button">Logg ut</button>
      </form>
    </div>
  </main>
</body>
</html>
