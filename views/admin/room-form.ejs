<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: room && room.id ? 'Rediger rom' : 'Nytt rom' }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <a class="back-link" href="/admin/rom"><%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %>Alle rom</a>

    <div class="page-head">
      <h1 class="title"><%= room && room.id ? 'Rediger ' + room.name : 'Nytt rom' %></h1>
      <% if (room && room.id) { %>
        <a class="btn btn-secondary" href="/rom/<%= room.id %>" data-preview><%- include('../partials/icon', { name: 'monitor', size: 15 }) %>Se som besøkende</a>
      <% } %>
    </div>

    <form class="form-card form-card-wide" method="post" action="<%= room && room.id ? '/admin/rom/' + room.id : '/admin/rom' %>">
      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= error %></span></div>
      <% } %>

      <h2 class="form-section-title">Om rommet</h2>
      <div class="field">
        <label for="name">Navn</label>
        <input class="input" type="text" id="name" name="name" maxlength="80" required value="<%= room ? room.name : '' %>" placeholder="F.eks. Fjordrommet" />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="location">Plassering <span class="label-hint">(valgfritt)</span></label>
          <input class="input" type="text" id="location" name="location" maxlength="80" value="<%= room && room.location ? room.location : '' %>" placeholder="F.eks. 3. etasje" />
        </div>
        <div class="field">
          <label for="capacity">Plasser <span class="label-hint">(valgfritt)</span></label>
          <input class="input" type="number" id="capacity" name="capacity" min="1" max="500" inputmode="numeric" value="<%= room && room.capacity ? room.capacity : '' %>" />
        </div>
      </div>
      <div class="field">
        <label for="description">Beskrivelse <span class="label-hint">(valgfritt, vises for alle som booker)</span></label>
        <textarea class="input" id="description" name="description" rows="3" maxlength="400" placeholder="Praktisk info, f.eks. hvor nøkkelen hentes eller hvordan skjermen slås på"><%= room && room.description ? room.description : '' %></textarea>
      </div>

      <div class="form-section"><fieldset class="fieldset">
        <legend class="form-section-title">Fasiliteter</legend>
        <p class="form-section-note">Vises med ikon på forsiden og romsiden, så de som booker ser hva rommet har.</p>
        <% const selected = room && room.facilities ? room.facilities : []; %>
        <div class="facility-grid">
          <% facilityOptions.forEach(function (f) { %>
            <label class="facility-option">
              <input type="checkbox" name="facilities" value="<%= f.key %>" <%= selected.includes(f.key) ? 'checked' : '' %> />
              <span class="facility-option-icon"><%- include('../partials/icon', { name: f.icon, size: 18 }) %></span>
              <span class="facility-option-text">
                <span><%= f.label %></span>
                <% if (f.hint) { %><span class="facility-option-hint"><%= f.hint %></span><% } %>
              </span>
              <span class="facility-option-check"><%- include('../partials/icon', { name: 'check', size: 14 }) %></span>
            </label>
          <% }) %>
        </div>
      </fieldset></div>

      <div class="form-section"><fieldset class="fieldset">
        <legend class="form-section-title">Regler for booking</legend>
        <p class="form-section-note">Gjelder for alle som booker via nettsiden. Administratorer kan overstyre reglene når de booker på vegne av andre.</p>
        <fieldset class="fieldset">
          <legend class="label">Dager</legend>
          <div class="day-picker">
            <% weekOrder.forEach(function (d) { %>
              <label class="day-option">
                <input type="checkbox" name="open_days" value="<%= d %>" <%= rules.openDays.includes(d) ? 'checked' : '' %> />
                <span><%= dayNames[d].slice(0, 3) %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <div class="field-row">
          <div class="field">
            <label for="open_from">Fra</label>
            <input class="input" type="time" id="open_from" name="open_from" step="900" value="<%= rules.openFrom %>" required />
          </div>
          <div class="field">
            <label for="open_to">Til</label>
            <input class="input" type="time" id="open_to" name="open_to" step="900" value="<%= rules.openTo %>" required />
          </div>
        </div>
        <div class="field-row field-row-thirds">
          <div class="field">
            <label for="max_duration_minutes">Maks varighet</label>
            <select class="input" id="max_duration_minutes" name="max_duration_minutes">
              <option value="">Ingen grense</option>
              <% durationOptions.forEach(function (m) { %>
                <option value="<%= m %>" <%= rules.maxDurationMinutes === m ? 'selected' : '' %>><%= formatDuration(m) %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="max_days_ahead">Dager frem i tid</label>
            <input class="input" type="number" id="max_days_ahead" name="max_days_ahead" min="1" max="730" inputmode="numeric" placeholder="Ingen grense" value="<%= rules.maxDaysAhead || '' %>" />
          </div>
          <div class="field">
            <label for="buffer_minutes">Pause mellom møter</label>
            <select class="input" id="buffer_minutes" name="buffer_minutes">
              <% bufferOptions.forEach(function (m) { %>
                <option value="<%= m %>" <%= rules.bufferMinutes === m ? 'selected' : '' %>><%= m ? m + ' min' : 'Ingen' %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </fieldset></div>

      <div class="form-section"><fieldset class="fieldset">
        <legend class="form-section-title">Farge i adminkalenderen</legend>
        <div class="swatches">
          <% const current = room && room.color ? room.color : colors[0];
             const options = colors.includes(current) ? colors : [current].concat(colors); %>
          <% options.forEach(function (c) { %>
            <label class="swatch" title="<%= c %>">
              <input type="radio" name="color" value="<%= c %>" <%= c === current ? 'checked' : '' %> aria-label="Farge <%= c %>" />
              <span style="--c: <%= c %>"></span>
            </label>
          <% }) %>
        </div>
      </fieldset></div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= room && room.id ? 'Lagre endringer' : 'Legg til rom' %></button>
        <a class="btn btn-ghost" href="/admin/rom">Avbryt</a>
      </div>
    </form>
  </main>

  <script src="/js/ui.js" defer></script>
</body>
</html>
