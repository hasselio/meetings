<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Min konto' }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <div class="page-head">
      <div>
        <h1 class="title">Min konto</h1>
        <p class="lede">Innlogget som <strong><%= me.username %></strong><% if (me.is_platform_admin) { %>, plattformadministrator<% } %>.</p>
      </div>
    </div>

    <% if (flash) { %>
      <div class="alert <%= flash.type === 'error' ? 'alert-error' : 'alert-success' %> form-card-wide" role="status">
        <%- include('../partials/icon', { name: flash.type === 'error' ? 'alert' : 'check', size: 16 }) %><span><%= flash.text %></span>
      </div>
    <% } %>

    <form class="form-card form-card-wide" method="post" action="/admin/konto">
      <h2 class="form-section-title">Kontoopplysninger</h2>
      <% if (profileError) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= profileError %></span></div>
      <% } %>
      <div class="field-row">
        <div class="field">
          <label for="name">Navn</label>
          <input class="input" type="text" id="name" name="name" maxlength="80" autocomplete="name" value="<%= values.name || '' %>" />
        </div>
        <div class="field">
          <label for="email">E-post <span class="label-hint">(for varsler og tilbakestilling)</span></label>
          <input class="input" type="email" id="email" name="email" maxlength="120" autocomplete="email" value="<%= values.email || '' %>" />
        </div>
      </div>
      <div class="field">
        <label for="username">Brukernavn</label>
        <input class="input" type="text" id="username" name="username" maxlength="40" pattern="[\w.@\-]{3,40}" autocomplete="username" value="<%= values.username %>" required />
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Lagre</button>
      </div>
    </form>

    <section class="form-card form-card-wide account-section" aria-labelledby="orgs-title">
      <h2 class="form-section-title" id="orgs-title">Bedrifter</h2>
      <% if (me.is_platform_admin) { %>
        <p class="form-section-note form-section-note-flush">Du er plattformadministrator og har tilgang til alle bedrifter. Velg bedrift i linjen øverst.</p>
      <% } %>
      <% if (memberships.length) { %>
        <ul class="membership-list">
          <% memberships.forEach(function (m) { %>
            <li>
              <span><%= m.name %><% if (!m.active) { %> <span class="tag tag-warning">Deaktivert</span><% } %></span>
              <span class="tag tag-role tag-role-<%= m.role %>"><%= roleLabel(m.role) %></span>
            </li>
          <% }) %>
        </ul>
      <% } else if (!me.is_platform_admin) { %>
        <p class="muted">Du er ikke med i noen bedrift.</p>
      <% } %>
      <% if (joinable.length) { %>
        <form method="post" action="/admin/konto/bedrifter" class="join-form">
          <h3 class="form-subtitle">Be om tilgang til en bedrift til</h3>
          <% if (joinError) { %>
            <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= joinError %></span></div>
          <% } %>
          <div class="field">
            <label for="joinOrg">Bedrift</label>
            <select class="input" id="joinOrg" name="organization" required>
              <% joinable.forEach(function (o) { %><option value="<%= o.id %>"><%= o.name %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="joinReason">Begrunnelse <span class="label-hint">(valgfritt)</span></label>
            <input class="input" type="text" id="joinReason" name="reason" maxlength="500" />
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-secondary">Send forespørsel</button>
          </div>
        </form>
      <% } %>
    </section>

    <form class="form-card form-card-wide account-section" method="post" action="/admin/konto/passord">
      <h2 class="form-section-title">Bytt passord</h2>
      <% if (passwordError) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= passwordError %></span></div>
      <% } %>
      <input type="text" name="username" value="<%= me.username %>" autocomplete="username" hidden />
      <div class="field">
        <label for="currentPassword">Nåværende passord</label>
        <input class="input" type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="password">Nytt passord <span class="label-hint">(minst 10 tegn)</span></label>
          <input class="input" type="password" id="password" name="password" minlength="10" autocomplete="new-password" required />
        </div>
        <div class="field">
          <label for="passwordConfirm">Gjenta nytt passord</label>
          <input class="input" type="password" id="passwordConfirm" name="passwordConfirm" minlength="10" autocomplete="new-password" required />
        </div>
      </div>
      <p class="form-section-note form-section-note-flush">Andre enheter der du er innlogget, logges ut når passordet byttes.</p>
      <div class="form-actions">
        <button type="submit" class="btn btn-secondary">Bytt passord</button>
      </div>
    </form>
  </main>

  <script src="/js/ui.js" defer></script>
</body>
</html>
