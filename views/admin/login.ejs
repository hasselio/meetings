<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <title>Admin-innlogging – Møteromsbooking</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main style="max-width:420px;">
    <div class="card">
      <h1>Admin-innlogging</h1>
      <% if (error) { %><div class="error-message"><%= error %></div><% } %>
      <form method="post" action="/admin/login">
        <div class="field">
          <label for="username">Brukernavn</label>
          <input type="text" id="username" name="username" required autofocus />
        </div>
        <div class="field">
          <label for="password">Passord</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="button" style="width:100%;">Logg inn</button>
      </form>
    </div>
    <p class="muted"><a href="/">&larr; Tilbake til møteromsoversikten</a></p>
  </main>
</body>
</html>
