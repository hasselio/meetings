<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Tilgang' }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <div class="page-head">
      <div>
        <h1 class="title">Tilgang til <%= org.name %></h1>
        <p class="lede">Brukergruppen som forvalter møterommene til <%= org.name %>. Rollene gjelder bare her; andre bedrifter styrer sine egne brukere.</p>
        <ul class="role-legend">
          <% Object.values(roles).forEach(function (role) { %>
            <li><strong><%= role.label %>:</strong> <%= role.description %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <% if (flash) { %>
      <div class="alert <%= flash.type === 'error' ? 'alert-error' : 'alert-success' %>" role="status">
        <%- include('../partials/icon', { name: flash.type === 'error' ? 'alert' : 'check', size: 16 }) %><span><%= flash.text %></span>
      </div>
    <% } %>

    <section class="section" aria-labelledby="requests-title">
      <h2 class="section-title" id="requests-title">Ventende forespørsler <span class="count"><%= requests.length %></span></h2>

      <% if (requests.length === 0) { %>
        <div class="board">
          <div class="empty-state">
            <span class="empty-icon"><%- include('../partials/icon', { name: 'check', size: 20 }) %></span>
            <h2>Ingen forespørsler venter</h2>
            <p>Del lenken <a href="/admin/be-om-tilgang?bedrift=<%= org.slug %>" target="_blank" rel="noopener">/admin/be-om-tilgang?bedrift=<%= org.slug %></a> med de som skal søke, så er <%= org.name %> valgt på forhånd.</p>
          </div>
        </div>
      <% } else { %>
        <p class="section-note"><%- include('../partials/icon', { name: 'alert', size: 14 }) %>E-postadressen er ikke bekreftet. Sjekk at du kjenner personen før du godkjenner.</p>
        <ul class="request-list">
          <% requests.forEach(function (r) { %>
            <li class="request">
              <div class="request-main">
                <div class="request-name"><%= r.name %><% if (r.user_id) { %> <span class="tag tag-role">Har konto fra før</span><% } %></div>
                <div class="request-meta">
                  <% if (r.email) { %><a href="mailto:<%= r.email %>"><%= r.email %></a><% } %>
                  <span>Brukernavn: <strong><%= r.username %></strong></span>
                  <span class="tabular"><%= new Date(r.created_at.replace(' ', 'T') + 'Z').toLocaleString('nb-NO', { timeZone: timezone, dateStyle: 'medium', timeStyle: 'short' }) %></span>
                </div>
                <% if (r.reason) { %><p class="request-reason"><%= r.reason %></p><% } %>
              </div>
              <div class="request-actions">
                <form method="post" action="/admin/tilgang/<%= r.id %>/avsla">
                  <button type="submit" class="btn btn-secondary btn-sm">Avslå</button>
                </form>
                <form method="post" action="/admin/tilgang/<%= r.id %>/godkjenn" class="approve-form">
                  <label class="sr-only" for="role-<%= r.id %>">Rolle for <%= r.name %></label>
                  <select class="input input-sm" id="role-<%= r.id %>" name="role">
                    <% Object.entries(roles).forEach(function ([key, role]) { %>
                      <option value="<%= key %>" <%= key === 'viewer' ? 'selected' : '' %>><%= role.label %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-primary btn-sm" data-confirm data-confirm-label="Bekreft godkjenning">
                    <%- include('../partials/icon', { name: 'check', size: 14 }) %>Godkjenn
                  </button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="section" aria-labelledby="members-title">
      <h2 class="section-title" id="members-title">Brukere i <%= org.name %> <span class="count"><%= members.length %></span></h2>
      <% if (!members.length) { %>
        <p class="muted">Ingen brukere ennå. Opprett den første under.</p>
      <% } else { %>
        <ul class="request-list">
          <% members.forEach(function (a) { const self = a.id === adminId; %>
            <li class="request request-compact">
              <div class="request-main">
                <div class="request-name">
                  <%= a.name || a.username %><% if (self) { %> <span class="you">deg</span><% } %>
                  <span class="tag tag-role tag-role-<%= a.role %>"><%= roleLabel(a.role) %></span>
                  <% if (a.is_platform_admin) { %><span class="tag tag-role">Plattformadministrator</span><% } %>
                  <% if (a.must_change_password) { %><span class="tag tag-warning">Må velge nytt passord</span><% } %>
                </div>
                <div class="request-meta">
                  <span>Brukernavn: <strong><%= a.username %></strong></span>
                  <% if (a.email) { %><a href="mailto:<%= a.email %>"><%= a.email %></a><% } else { %><span class="muted">Ingen e-post</span><% } %>
                  <% if (a.other_orgs) { %><span class="muted">Også med i <%= a.other_orgs %> annen bedrift<%= a.other_orgs > 1 ? 'er' : '' %></span><% } %>
                </div>
              </div>
              <a class="btn btn-secondary btn-sm" href="<%= self ? '/admin/konto' : '/admin/brukere/' + a.id %>">
                <%- include('../partials/icon', { name: 'pencil', size: 14 }) %><%= self ? 'Min konto' : 'Administrer' %>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="section" aria-labelledby="create-title">
      <form class="form-card form-card-wide" method="post" action="/admin/brukere" id="opprett">
        <h2 class="form-section-title" id="create-title">Opprett bruker</h2>
        <p class="form-section-note form-section-note-flush">Brukeren får et midlertidig passord som vises én gang, og må velge sitt eget ved første innlogging.</p>
        <% if (createError) { %>
          <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span><%= createError %></span></div>
        <% } %>
        <div class="field-row">
          <div class="field">
            <label for="newName">Navn</label>
            <input class="input" type="text" id="newName" name="name" maxlength="80" value="<%= createValues.name || '' %>" />
          </div>
          <div class="field">
            <label for="newEmail">E-post</label>
            <input class="input" type="email" id="newEmail" name="email" maxlength="120" value="<%= createValues.email || '' %>" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="newUsername">Brukernavn</label>
            <input class="input" type="text" id="newUsername" name="username" maxlength="40" pattern="[\w.@\-]{3,40}" value="<%= createValues.username || '' %>" required />
          </div>
          <div class="field">
            <label for="newRole">Rolle</label>
            <select class="input" id="newRole" name="role">
              <% Object.entries(roles).forEach(function ([key, role]) { %>
                <option value="<%= key %>" <%= (createValues.role || 'viewer') === key ? 'selected' : '' %>><%= role.label %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <% if (canEmail) { %>
          <label class="check">
            <input type="checkbox" name="sendEmail" value="1" />
            <span>Send det midlertidige passordet på e-post</span>
          </label>
        <% } %>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%- include('../partials/icon', { name: 'plus', size: 15 }) %>Opprett bruker</button>
        </div>
      </form>

      <% if (me.is_platform_admin) { %>
        <form class="form-card form-card-wide account-section" method="post" action="/admin/brukere/eksisterende">
          <h2 class="form-section-title">Legg til eksisterende bruker <span class="tag tag-role">Plattform</span></h2>
          <p class="form-section-note form-section-note-flush">For personer som allerede har konto i en annen bedrift, f.eks. konsulenter eller fellestjenester.</p>
          <div class="field-row">
            <div class="field">
              <label for="existingUsername">Brukernavn</label>
              <input class="input" type="text" id="existingUsername" name="username" maxlength="40" required />
            </div>
            <div class="field">
              <label for="existingRole">Rolle</label>
              <select class="input" id="existingRole" name="role">
                <% Object.entries(roles).forEach(function ([key, role]) { %>
                  <option value="<%= key %>" <%= key === 'viewer' ? 'selected' : '' %>><%= role.label %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-secondary">Legg til</button>
          </div>
        </form>
      <% } %>
    </section>

    <% if (decisions.length) { %>
      <section class="section" aria-labelledby="history-title">
        <h2 class="section-title" id="history-title">Sist behandlet</h2>
        <ul class="request-list">
          <% decisions.forEach(function (d) { %>
            <li class="request request-compact">
              <div class="request-main">
                <div class="request-name"><%= d.name %> <span class="muted">(<%= d.username %>)</span></div>
                <div class="request-meta">
                  <span class="decision decision-<%= d.status %>"><%= d.status === 'approved' ? 'Godkjent' : 'Avslått' %></span>
                  <span class="tabular"><%= new Date(d.decided_at.replace(' ', 'T') + 'Z').toLocaleString('nb-NO', { timeZone: timezone, dateStyle: 'medium', timeStyle: 'short' }) %></span>
                  <% if (d.decided_by_username) { %><span>av <%= d.decided_by_username %></span><% } %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </main>

  <script src="/js/ui.js" defer></script>
</body>
</html>
