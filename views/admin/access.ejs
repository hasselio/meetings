<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Tilgang' }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <div class="page-head">
      <div>
        <h1 class="title">Tilgang</h1>
        <p class="lede">Godkjenn eller avslå forespørsler om tilgang, velg rolle, og administrer kontoene til de som har tilgang.</p>
        <ul class="role-legend">
          <% Object.values(roles).forEach(function (role) { %>
            <li><strong><%= role.label %>:</strong> <%= role.description %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <% if (flash) { %>
      <div class="alert <%= flash.type === 'error' ? 'alert-error' : 'alert-success' %>" role="status">
        <%- include('../partials/icon', { name: flash.type === 'error' ? 'alert' : 'check', size: 16 }) %><span><%= flash.text %></span>
      </div>
    <% } %>

    <section class="section" aria-labelledby="requests-title">
      <h2 class="section-title" id="requests-title">Ventende forespørsler <span class="count"><%= requests.length %></span></h2>

      <% if (requests.length === 0) { %>
        <div class="board">
          <div class="empty-state">
            <span class="empty-icon"><%- include('../partials/icon', { name: 'check', size: 20 }) %></span>
            <h2>Ingen forespørsler venter</h2>
            <p>Nye forespørsler fra <a href="/admin/be-om-tilgang" target="_blank" rel="noopener">«Be om tilgang»</a> dukker opp her.</p>
          </div>
        </div>
      <% } else { %>
        <p class="section-note"><%- include('../partials/icon', { name: 'alert', size: 14 }) %>E-postadressen er ikke bekreftet. Sjekk at du kjenner personen før du godkjenner.</p>
        <ul class="request-list">
          <% requests.forEach(function (r) { %>
            <li class="request">
              <div class="request-main">
                <div class="request-name"><%= r.name %></div>
                <div class="request-meta">
                  <a href="mailto:<%= r.email %>"><%= r.email %></a>
                  <span>Brukernavn: <strong><%= r.username %></strong></span>
                  <span class="tabular"><%= new Date(r.created_at.replace(' ', 'T') + 'Z').toLocaleString('nb-NO', { timeZone: timezone, dateStyle: 'medium', timeStyle: 'short' }) %></span>
                </div>
                <% if (r.reason) { %><p class="request-reason"><%= r.reason %></p><% } %>
              </div>
              <div class="request-actions">
                <form method="post" action="/admin/tilgang/<%= r.id %>/avsla">
                  <button type="submit" class="btn btn-secondary btn-sm">Avslå</button>
                </form>
                <form method="post" action="/admin/tilgang/<%= r.id %>/godkjenn" class="approve-form">
                  <label class="sr-only" for="role-<%= r.id %>">Rolle for <%= r.name %></label>
                  <select class="input input-sm" id="role-<%= r.id %>" name="role">
                    <% Object.entries(roles).forEach(function ([key, role]) { %>
                      <option value="<%= key %>" <%= key === 'viewer' ? 'selected' : '' %>><%= role.label %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-primary btn-sm" data-confirm data-confirm-label="Bekreft godkjenning">
                    <%- include('../partials/icon', { name: 'check', size: 14 }) %>Godkjenn
                  </button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="section" aria-labelledby="admins-title">
      <h2 class="section-title" id="admins-title">Brukere med tilgang <span class="count"><%= admins.length %></span></h2>
      <ul class="request-list">
        <% admins.forEach(function (a) { const self = a.id === adminId; %>
          <li class="request request-compact">
            <div class="request-main">
              <div class="request-name">
                <%= a.name || a.username %><% if (self) { %> <span class="you">deg</span><% } %>
                <span class="tag tag-role tag-role-<%= a.role %>"><%= roleLabel(a.role) %></span>
                <% if (a.must_change_password) { %><span class="tag tag-warning">Må velge nytt passord</span><% } %>
              </div>
              <div class="request-meta">
                <span>Brukernavn: <strong><%= a.username %></strong></span>
                <% if (a.email) { %><a href="mailto:<%= a.email %>"><%= a.email %></a><% } else { %><span class="muted">Ingen e-post</span><% } %>
                <span class="tabular">Lagt til <%= new Date(a.created_at.replace(' ', 'T') + 'Z').toLocaleDateString('nb-NO', { timeZone: timezone, dateStyle: 'medium' }) %></span>
              </div>
            </div>
            <a class="btn btn-secondary btn-sm" href="<%= self ? '/admin/konto' : '/admin/administratorer/' + a.id %>">
              <%- include('../partials/icon', { name: 'pencil', size: 14 }) %><%= self ? 'Min konto' : 'Administrer' %>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>

    <% if (decisions.length) { %>
      <section class="section" aria-labelledby="history-title">
        <h2 class="section-title" id="history-title">Sist behandlet</h2>
        <ul class="request-list">
          <% decisions.forEach(function (d) { %>
            <li class="request request-compact">
              <div class="request-main">
                <div class="request-name"><%= d.name %> <span class="muted">(<%= d.username %>)</span></div>
                <div class="request-meta">
                  <span class="decision decision-<%= d.status %>"><%= d.status === 'approved' ? 'Godkjent' : 'Avslått' %></span>
                  <span class="tabular"><%= new Date(d.decided_at.replace(' ', 'T') + 'Z').toLocaleString('nb-NO', { timeZone: timezone, dateStyle: 'medium', timeStyle: 'short' }) %></span>
                  <% if (d.decided_by_username) { %><span>av <%= d.decided_by_username %></span><% } %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </main>

  <script src="/js/ui.js" defer></script>
</body>
</html>
