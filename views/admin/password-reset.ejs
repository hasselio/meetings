<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Passord tilbakestilt' }) %>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main id="innhold" class="container">
    <div class="form-card form-card-wide">
      <span class="success-icon"><%- include('../partials/icon', { name: 'check', size: 20 }) %></span>
      <h1 class="title">Passordet er tilbakestilt</h1>
      <p class="lede">
        <%= target.name || target.username %> er logget ut overalt og må velge et nytt passord ved neste innlogging.
      </p>

      <div class="temp-password">
        <div>
          <div class="label">Midlertidig passord for «<%= target.username %>»</div>
          <code id="tempPassword"><%= password %></code>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" id="copyBtn">Kopier</button>
      </div>

      <% if (mailed) { %>
        <div class="alert alert-success" role="status"><%- include('../partials/icon', { name: 'check', size: 16 }) %><span>Passordet er også sendt til <%= target.email %>.</span></div>
      <% } else if (triedMail) { %>
        <div class="alert alert-error" role="alert"><%- include('../partials/icon', { name: 'alert', size: 16 }) %><span>E-posten kunne ikke sendes. Gi passordet videre selv.</span></div>
      <% } %>

      <p class="form-section-note form-section-note-flush">
        Passordet vises bare nå. Gi det videre på en trygg måte, helst muntlig eller i en annen kanal enn e-post.
      </p>
      <div class="form-actions">
        <a class="btn btn-primary" href="/admin/tilgang">Ferdig</a>
      </div>
    </div>
  </main>

  <script src="/js/ui.js" defer></script>
  <script>
    document.getElementById('copyBtn').addEventListener('click', function () {
      navigator.clipboard.writeText(document.getElementById('tempPassword').textContent).then(
        function () { UI.toast('Passordet er kopiert.'); },
        function () { UI.toast('Kunne ikke kopiere. Marker teksten og kopier manuelt.', { type: 'alert' }); }
      );
    });
  </script>
</body>
</html>
