<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: 'Ledige rom' }) %>
</head>
<body>
  <%- include('../partials/public-header') %>

  <main id="innhold" class="container">
    <div class="page-head">
      <div>
        <p class="eyebrow"><%= today.charAt(0).toUpperCase() + today.slice(1) %></p>
        <h1 class="display">Finn et ledig rom</h1>
        <p class="lede">
          <% if (rooms.length === 0) { %>
            Det er ikke lagt inn noen møterom ennå.
          <% } else if (freeCount === rooms.length) { %>
            Alle <%= rooms.length %> rom er ledige akkurat nå. Velg et rom for å se uka og booke.
          <% } else { %>
            <%= freeCount %> av <%= rooms.length %> rom er ledige akkurat nå. Velg et rom for å se uka og booke.
          <% } %>
        </p>
      </div>
    </div>

    <% if (rooms.length === 0) { %>
      <section class="board">
        <div class="empty-state">
          <span class="empty-icon"><%- include('../partials/icon', { name: 'door', size: 22 }) %></span>
          <h2>Ingen rom å vise</h2>
          <p>Når rom er lagt inn av en administrator, ser du dem her sammen med dagens ledige tider.</p>
        </div>
      </section>
    <% } else { %>
      <section class="board" aria-label="Møterom">
        <div class="board-head" aria-hidden="true">
          <span>Rom</span>
          <span>I dag</span>
          <span>Status</span>
          <span></span>
        </div>
        <% rooms.forEach(function (room, i) { const s = room.status; %>
          <a class="room-row" href="/rom/<%= room.id %>" style="--i: <%= i %>">
            <div class="room-row-info">
              <div class="room-row-name"><%= room.name %></div>
              <div class="room-row-meta">
                <% if (room.location) { %>
                  <span class="meta-item"><%- include('../partials/icon', { name: 'pin', size: 14 }) %><%= room.location %></span>
                <% } %>
                <% if (room.capacity) { %>
                  <span class="meta-item"><%- include('../partials/icon', { name: 'users', size: 14 }) %><%= room.capacity %> plasser</span>
                <% } %>
              </div>
              <% if (room.facilityList.length) { %>
                <span class="facility-icons" role="img" aria-label="Fasiliteter: <%= room.facilityList.map(function (f) { return f.label; }).join(', ') %>">
                  <% room.facilityList.forEach(function (f) { %>
                    <span title="<%= f.label %>"><%- include('../partials/icon', { name: f.icon, size: 15 }) %></span>
                  <% }) %>
                </span>
              <% } %>
            </div>

            <div class="timeline" aria-hidden="true">
              <div class="timeline-track">
                <div class="timeline-past" style="width: <%= s.nowPercent.toFixed(2) %>%"></div>
                <% s.segments.forEach(function (seg) { %>
                  <div class="timeline-busy" style="left: <%= seg.left.toFixed(2) %>%; width: <%= seg.width.toFixed(2) %>%"></div>
                <% }) %>
                <% if (s.nowPercent > 0 && s.nowPercent < 100) { %>
                  <div class="timeline-now" style="left: <%= s.nowPercent.toFixed(2) %>%"></div>
                <% } %>
              </div>
              <div class="timeline-scale tabular">
                <% hours.forEach(function (h) { %><span><%= h %></span><% }) %>
              </div>
            </div>

            <div class="room-row-status">
              <span class="status <%= s.free ? 'status-free' : 'status-busy' %>">
                <span class="status-dot"></span><%= s.free ? 'Ledig nå' : 'Opptatt nå' %>
              </span>
              <span class="status-detail tabular"><%= s.detail %></span>
            </div>

            <span class="room-row-arrow"><%- include('../partials/icon', { name: 'arrow-right', size: 18 }) %></span>
          </a>
        <% }) %>
      </section>
    <% } %>
  </main>
  <%- include('../partials/public-footer') %>
</body>
</html>
