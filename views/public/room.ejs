<!DOCTYPE html>
<html lang="nb">
<head>
  <%- include('../partials/head', { title: room.name, calendar: true, description: 'Se når ' + room.name + ' er ledig og book direkte.' }) %>
  <script src="/vendor/altcha/nb.js" defer></script>
  <script src="/vendor/altcha/altcha.min.js" defer></script>
</head>
<body>
  <%- include('../partials/public-header') %>

  <main id="innhold" class="container">
    <a class="back-link" href="/"><%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %>Alle rom</a>

    <div class="page-head">
      <div>
        <h1 class="title"><%= room.name %></h1>
        <div class="room-intro">
          <span class="status status-pill <%= status.free ? 'status-free' : 'status-busy' %>">
            <span class="status-dot"></span><%= status.detail %>
          </span>
          <% if (room.location) { %>
            <span class="meta-item"><%- include('../partials/icon', { name: 'pin', size: 15 }) %><%= room.location %></span>
          <% } %>
          <% if (room.capacity) { %>
            <span class="meta-item"><%- include('../partials/icon', { name: 'users', size: 15 }) %><%= room.capacity %> plasser</span>
          <% } %>
        </div>
        <% if (room.description) { %><p class="room-description"><%= room.description %></p><% } %>
        <ul class="room-rules" aria-label="Regler for booking">
          <% rules.forEach(function (rule) { %><li><%= rule %></li><% }) %>
        </ul>
        <% if (facilityList.length) { %>
          <ul class="facility-chips facility-chips-public" aria-label="Fasiliteter">
            <% facilityList.forEach(function (f) { %>
              <li class="facility-chip"><%- include('../partials/icon', { name: f.icon, size: 15 }) %><%= f.label %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <div class="room-layout">
      <section class="calendar-card" aria-label="Kalender for <%= room.name %>">
        <div id="calendar" data-room-id="<%= room.id %>"
          data-open-from="<%= ruleConfig.openFrom %>" data-open-to="<%= ruleConfig.openTo %>"
          data-open-days="<%= ruleConfig.openDays.join(',') %>"
          data-max-minutes="<%= ruleConfig.maxDurationMinutes || '' %>" data-max-days="<%= ruleConfig.maxDaysAhead || '' %>"
          data-max-occurrences="<%= maxOccurrences %>"></div>
        <div class="calendar-legend">
          <span><span class="legend-swatch legend-busy"></span>Opptatt</span>
          <span><span class="legend-swatch legend-selection"></span>Ditt valg</span>
          <span>Dra over en ledig tid i kalenderen for å velge den.</span>
        </div>
      </section>

      <aside class="panel" id="booking" aria-labelledby="booking-title">
        <div id="bookingFormView">
          <h2 class="panel-title" id="booking-title">Book rommet</h2>
          <p class="panel-sub">Velg tid her eller direkte i kalenderen.</p>

          <form class="panel-form" id="bookingForm" novalidate>
            <div id="formAlert" role="alert"></div>

            <div class="field-row field-row-3">
              <div class="field">
                <label for="date">Dato</label>
                <input class="input" type="date" id="date" name="date" required />
              </div>
              <div class="field">
                <label for="startTime">Fra</label>
                <input class="input" type="time" id="startTime" name="startTime" step="900" required />
              </div>
              <div class="field">
                <label for="endTime">Til</label>
                <input class="input" type="time" id="endTime" name="endTime" step="900" required aria-describedby="timeError" />
              </div>
            </div>
            <p class="field-error field-error-row" id="timeError"></p>

            <div class="chips" role="group" aria-label="Varighet">
              <button type="button" class="chip" data-minutes="30" aria-pressed="false">30 min</button>
              <button type="button" class="chip" data-minutes="60" aria-pressed="false">1 t</button>
              <button type="button" class="chip" data-minutes="90" aria-pressed="false">1,5 t</button>
              <button type="button" class="chip" data-minutes="120" aria-pressed="false">2 t</button>
            </div>

            <div class="field-row repeat-row">
              <div class="field">
                <label for="repeat">Gjentas</label>
                <select class="input" id="repeat" name="repeat">
                  <option value="none">Nei, bare én gang</option>
                  <% Object.entries(repeatPatterns).forEach(function ([key, p]) { %>
                    <option value="<%= key %>"><%= p.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field" id="repeatUntilField" hidden>
                <label for="repeatUntil">Til og med</label>
                <input class="input" type="date" id="repeatUntil" name="repeatUntil" aria-describedby="repeatSummary" />
              </div>
            </div>
            <div class="repeat-extra" id="repeatExtra" hidden>
              <p class="field-hint" id="repeatSummary" aria-live="polite"></p>
              <label class="check">
                <input type="checkbox" id="skipConflicts" name="skipConflicts" checked />
                <span>Hopp over datoer som allerede er opptatt</span>
              </label>
            </div>

            <div class="field">
              <label for="title">Hva er møtet?</label>
              <input class="input" type="text" id="title" name="title" maxlength="120" placeholder="F.eks. Prosjektmøte" required aria-describedby="titleError" />
              <p class="field-error" id="titleError"></p>
            </div>
            <div class="field">
              <label for="organizerName">Navn</label>
              <input class="input" type="text" id="organizerName" name="organizerName" maxlength="80" autocomplete="name" required aria-describedby="organizerNameError" />
              <p class="field-error" id="organizerNameError"></p>
            </div>
            <div class="field">
              <label for="organizerEmail">E-post</label>
              <input class="input" type="email" id="organizerEmail" name="organizerEmail" autocomplete="email" inputmode="email" required aria-describedby="organizerEmailError" />
              <p class="field-error" id="organizerEmailError"></p>
            </div>
            <div class="field">
              <label for="notes">Notat <span class="label-hint">(valgfritt)</span></label>
              <textarea class="input" id="notes" name="notes" rows="2" maxlength="500"></textarea>
            </div>

            <div class="honeypot" aria-hidden="true">
              <label for="website">Nettside</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="field captcha">
              <altcha-widget challenge="/api/altcha" name="altcha" language="nb" auto="onfocus" configuration='{"hideLogo": true}'></altcha-widget>
              <noscript><p class="field-error">Booking krever JavaScript.</p></noscript>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="submitBtn">Book møte</button>
            <p class="panel-note">
              <% if (confirmationRequired) { %>
                Du får en e-post med en lenke for å bekrefte. Tiden holdes av i <%= holdMinutes %> minutter, og bookingen gjelder når du har bekreftet.
              <% } else if (mailEnabled) { %>
                Du får en kalenderinvitasjon på e-post.
              <% } else { %>
                Etter bookingen får du en lenke du kan bruke til å endre eller avbestille.
              <% } %>
              Navnet og e-posten din vises bare for administratorer, ikke for andre som ser kalenderen. <a href="/personvern">Personvern</a>
            </p>
          </form>
        </div>

        <div id="bookingSuccessView" hidden>
          <div class="success">
            <span class="success-icon"><%- include('../partials/icon', { name: 'check', size: 20 }) %></span>
            <h2 class="panel-title" tabindex="-1" id="successTitle">Møtet er booket</h2>
            <p class="panel-sub" id="successMail"></p>
            <div class="manage-link" id="successManage" hidden>
              <p>Lagre denne lenken. Med den kan du endre eller avbestille senere:</p>
              <a id="successManageLink" href="#"></a>
            </div>
            <ul class="skipped-list" id="successSkipped" hidden></ul>
            <dl class="summary">
              <div><dt>Rom</dt><dd><%= room.name %></dd></div>
              <div><dt>Når</dt><dd class="tabular" id="successWhen"></dd></div>
              <div><dt>Møte</dt><dd id="successTitleText"></dd></div>
            </dl>
            <button type="button" class="btn btn-secondary btn-block" id="newBookingBtn">Book en ny tid</button>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <%- include('../partials/public-footer') %>

  <script src="/js/ui.js" defer></script>
  <script src="/js/booking.js" defer></script>
</body>
</html>
