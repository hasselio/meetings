<a class="skip-link" href="#innhold">Hopp til innhold</a>
<header class="site-header site-header-admin">
  <div class="container">
    <%- include('brand', { href: '/admin', tag: 'Admin' }) %>
    <nav class="nav nav-primary" aria-label="Adminmeny">
      <a class="nav-link" href="/admin" <%- locals.section === 'bookings' ? 'aria-current="page"' : '' %>>Bookinger</a>
      <a class="nav-link" href="/admin/rom" <%- locals.section === 'rooms' ? 'aria-current="page"' : '' %>>Rom</a>
      <% const allowed = (p) => Boolean(locals.can && locals.can(p)); %>
      <% if (allowed('reports.view')) { %>
        <a class="nav-link" href="/admin/rapporter" <%- locals.section === 'reports' ? 'aria-current="page"' : '' %>>Rapporter</a>
      <% } %>
      <% if (allowed('access.manage')) { %>
        <a class="nav-link" href="/admin/tilgang" <%- locals.section === 'access' ? 'aria-current="page"' : '' %>>
          Tilgang<% if (locals.pendingCount) { %> <span class="badge" aria-label="<%= pendingCount %> venter"><%= pendingCount %></span><% } %>
        </a>
      <% } %>
      <% if (allowed('audit.view')) { %>
        <a class="nav-link" href="/admin/logg" <%- locals.section === 'audit' ? 'aria-current="page"' : '' %>>Logg</a>
      <% } %>
    </nav>
    <div class="nav nav-secondary">
      <a class="nav-link" href="<%= locals.org ? "/b/" + org.slug : "/" %>" data-preview aria-label="Se som besøkende">
        <%- include('icon', { name: 'monitor', size: 15 }) %> <span class="nav-text">Se som besøkende</span>
      </a>
      <%- include('theme-toggle') %>
      <a class="nav-link" href="/admin/konto" <%- locals.section === 'account' ? 'aria-current="page"' : '' %> aria-label="Min konto">
        <%- include('icon', { name: 'user', size: 15 }) %> <span class="nav-text">Min konto</span>
      </a>
      <form method="post" action="/admin/logout">
        <button type="submit" class="nav-link" aria-label="Logg ut">
          <%- include('icon', { name: 'logout', size: 15 }) %> <span class="nav-text">Logg ut</span>
        </button>
      </form>
    </div>
  </div>
</header>
<% if (locals.me) { const orgList = locals.orgs || []; %>
  <div class="org-bar">
    <div class="container">
      <div class="org-bar-current">
        <%- include('icon', { name: 'building', size: 15 }) %>
        <% if (orgList.length > 1) { %>
          <form method="post" action="/admin/bedrift" class="org-switch">
            <input type="hidden" name="section" value="<%= locals.section || '' %>" />
            <label class="sr-only" for="orgSwitch">Bedrift du jobber i</label>
            <select id="orgSwitch" name="org" data-autosubmit>
              <% orgList.forEach(function (o) { %>
                <option value="<%= o.id %>" <%= locals.org && o.id === locals.org.id ? 'selected' : '' %>><%= o.name %><%= o.active ? '' : ' (deaktivert)' %></option>
              <% }) %>
            </select>
            <noscript><button type="submit" class="btn btn-secondary btn-sm">Bytt</button></noscript>
          </form>
        <% } else if (locals.org) { %>
          <strong><%= org.name %></strong>
        <% } else { %>
          <span class="muted">Ingen bedrifter ennå</span>
        <% } %>
        <% if (locals.org && !org.active) { %><span class="tag tag-warning">Deaktivert</span><% } %>
        <span class="org-bar-role">
          <%= me.is_platform_admin ? 'Plattformadministrator' : (me.role ? roleLabel(me.role) : '') %>
        </span>
      </div>
      <% if (me.is_platform_admin) { %>
        <a class="org-bar-link" href="/admin/plattform" <%- locals.section === 'platform' ? 'aria-current="page"' : '' %>>
          <%- include('icon', { name: 'shield', size: 14 }) %>Plattform
        </a>
      <% } %>
    </div>
  </div>
<% } %>
