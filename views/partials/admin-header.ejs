<a class="skip-link" href="#innhold">Hopp til innhold</a>
<header class="site-header">
  <div class="container">
    <%- include('brand', { href: '/admin', tag: 'Admin' }) %>
    <nav class="nav" aria-label="Adminmeny">
      <a class="nav-link" href="/admin" <%- locals.section === 'bookings' ? 'aria-current="page"' : '' %>>Bookinger</a>
      <a class="nav-link" href="/admin/rom" <%- locals.section === 'rooms' ? 'aria-current="page"' : '' %>>Rom</a>
      <a class="nav-link" href="/admin/tilgang" <%- locals.section === 'access' ? 'aria-current="page"' : '' %>>
        Tilgang<% if (locals.pendingCount) { %> <span class="badge" aria-label="<%= pendingCount %> venter"><%= pendingCount %></span><% } %>
      </a>
      <span class="nav-divider" aria-hidden="true"></span>
      <a class="nav-link" href="/" data-preview aria-label="Se som besøkende">
        <%- include('icon', { name: 'monitor', size: 15 }) %> <span class="nav-text">Se som besøkende</span>
      </a>
      <form method="post" action="/admin/logout">
        <button type="submit" class="nav-link" aria-label="Logg ut">
          <%- include('icon', { name: 'logout', size: 15 }) %> <span class="nav-text">Logg ut</span>
        </button>
      </form>
    </nav>
  </div>
</header>
