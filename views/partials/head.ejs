<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title><%= typeof title !== 'undefined' ? title + ' · ' + appName : appName %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Se ledige møterom og book direkte. Du får en kalenderinvitasjon på e-post.' %>" />
<meta name="theme-color" content="#f6f5f3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141312" media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/vendor/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/css/style.css" />
<script>if (window.self !== window.top) document.documentElement.classList.add('in-frame');</script>
<% if (typeof calendar !== 'undefined' && calendar) { %>
<script src="/vendor/fullcalendar/fullcalendar.min.js" defer></script>
<script src="/vendor/fullcalendar/nb.min.js" defer></script>
<% } %>
